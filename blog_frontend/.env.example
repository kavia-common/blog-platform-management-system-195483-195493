# Backend base URL for REST API calls.
# One of these should be set. If both are set, REACT_APP_API_BASE is used first.
REACT_APP_API_BASE=http://localhost:8000/api
# Alternative name supported by the app
REACT_APP_BACKEND_URL=http://localhost:8000

# Optional: used only for documentation/redirects in some environments
REACT_APP_FRONTEND_URL=http://localhost:3000
